---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = 'About';
const identity = {
  firstName: 'Raphael',
  country: 'Germany',
  occupation: 'Software Developer',
  hobbies: ['typography', 'podcasts']
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro"];

const happy = true;
const finished = true;
const goal = 3;
---
<BaseLayout pageTitle={pageTitle}>
    <h2>Still under construction...</h2>

    <p>Software developer working at the intersection of complex logic and clean interfaces. I enjoy untangling intricate systems and crafting solutions that feel effortless.
    Currently focused on frontend development with growing full-stack capabilities.</p>

    <p>Here are a few facts about me:</p>
    <ul>
        <li>My name is {identity.firstName}.</li>
        <li>I live in {identity.country} and I work as a {identity.occupation}.</li>
        {identity.hobbies.length >= 2 &&
        <li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
        }
    </ul>
    <p>My skills are:</p>
    <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>

    {happy && <p>I am happy to be learning Astro!</p>}
    {finished && <p>I finished this tutorial!</p>}
    {goal === 3 ? <p>My goal is to finish in 3 days.</p> : <p>My goal is not 3 days.</p>}
</BaseLayout>
