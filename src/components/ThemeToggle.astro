<label class="theme-toggle">
  <input
    type="checkbox"
    class="toggle-input"
    aria-label="Toggle dark mode"
  />
  <span class="toggle-track">
    <span class="toggle-thumb"></span>
  </span>
  <span class="toggle-text">dark mode</span>
</label>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.18s var(--ease);
  }

  .theme-toggle:hover {
    color: var(--color-text);
  }

  .toggle-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .toggle-track {
    width: 24px;
    height: 12px;
    border: 1px solid currentColor;
    position: relative;
    flex-shrink: 0;
    transition: border-color 0.18s var(--ease);
  }

  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 6px;
    height: 6px;
    background: currentColor;
    transition: transform 0.22s var(--ease);
  }

  :global(html.dark) .toggle-thumb {
    transform: translateX(12px);
  }

  .toggle-text {
    white-space: nowrap;
  }
</style>

<script>
  // Toggle dark mode and persist the choice.
  function handleToggleChange() {
    const html = document.documentElement;
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    document.querySelectorAll('.toggle-input').forEach((input) => {
      (input as HTMLInputElement).checked = isDark;
    });
  }

  // Called on every page load because the toggle element gets swapped
  // (not persisted) on each client-side navigation.
  function initToggle() {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('.toggle-input').forEach((input) => {
      (input as HTMLInputElement).checked = isDark;
      (input as HTMLInputElement).addEventListener('change', handleToggleChange);
    });
  }

  document.addEventListener('astro:page-load', initToggle);
</script>