---
interface Props {
  currentPath: string;
  variant?: 'corner' | 'overlay';
}

const { currentPath, variant = 'corner' } = Astro.props;

const links = [
  { href: '/', label: 'home' },
  { href: '/about/', label: 'about' },
  { href: '/blog/', label: 'blog' },
  { href: '/tags/', label: 'tags' },
  { href: '#', label: 'search' },
];

function isActive(href: string, current: string): boolean {
  if (href === '/') return current === '/';
  return current.startsWith(href);
}
---

<ul class:list={['nav-links', `nav-links--${variant}`]}>
  {links.map((link) => (
    <li>
      <a
        href={link.href}
        class:list={[{ active: isActive(link.href, currentPath) }]}
      >
        <span class="dash"></span>
        {link.label}
      </a>
    </li>
  ))}
</ul>

<style>
  /* ── Shared base styles ── */
  .nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-weight: var(--font-weight-light);
    text-transform: lowercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }

  .nav-links .dash {
    display: inline-block;
    height: 1px;
    background: currentColor;
    flex-shrink: 0;
    transition: width 0.18s var(--ease);
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--color-text);
  }

  /* ── Corner variant (desktop vertical nav) ── */
  .nav-links--corner {
    gap: 0.25rem;
  }

  .nav-links--corner a {
    gap: 0.55rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    line-height: 1.7;
  }

  .nav-links--corner .dash {
    width: 12px;
  }

  .nav-links--corner a:hover .dash,
  .nav-links--corner a.active .dash {
    width: 20px;
  }

  /* ── Overlay variant (mobile fullscreen nav) ── */
  .nav-links--overlay {
    align-items: flex-start;
    gap: 0.15rem;
  }

  .nav-links--overlay li {
    overflow: hidden;
  }

  .nav-links--overlay a {
    gap: 0.75rem;
    font-size: clamp(1.1rem, 5vw, 1.4rem);
    letter-spacing: 0.08em;
    padding: 0.5rem 0;
    transform: translateY(120%);
    transition:
      transform 0.4s var(--ease),
      color 0.18s var(--ease);
  }

  .nav-links--overlay .dash {
    width: 14px;
  }

  .nav-links--overlay a:hover .dash,
  .nav-links--overlay a.active .dash {
    width: 24px;
  }

  /* Staggered entrance — activated when overlay gains .open */
  :global(.mobile-overlay.open) .nav-links--overlay li:nth-child(1) a { transform: translateY(0); transition-delay: 0.05s, 0s; }
  :global(.mobile-overlay.open) .nav-links--overlay li:nth-child(2) a { transform: translateY(0); transition-delay: 0.1s, 0s; }
  :global(.mobile-overlay.open) .nav-links--overlay li:nth-child(3) a { transform: translateY(0); transition-delay: 0.15s, 0s; }
  :global(.mobile-overlay.open) .nav-links--overlay li:nth-child(4) a { transform: translateY(0); transition-delay: 0.2s, 0s; }
  :global(.mobile-overlay.open) .nav-links--overlay li:nth-child(5) a { transform: translateY(0); transition-delay: 0.25s, 0s; }
</style>
