<div id="main-menu" class="nav-links">
  <button class="menu-close-button" aria-label="Close menu">&times;</button>
  <a href="/">Home</a>
  <a href="/about/">About</a>
  <a href="/blog/">Blog</a>
  <a href="/tags/">Tags</a>
</div>

<style>
  .nav-links {
    width: 100%;
    display: none;
    margin: 0;
    background-color: var(--color-bg-surface);
  }

  .nav-links a {
    display: block;
    text-align: center;
    padding: var(--space-sm) 0;
    text-decoration: none;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    color: var(--color-link);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--color-link-hover);
  }

  .menu-close-button {
    display: none;
  }

  /* Mobile: Fullscreen overlay when menu is open */
  @media screen and (max-width: 639px) {
    :global(:has(.menu-button[aria-expanded="true"])) .nav-links {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: var(--space-sm);
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 100;
      background-color: var(--color-bg-surface);
    }

    :global(:has(.menu-button[aria-expanded="true"])) .nav-links a {
      font-size: var(--font-size-2xl);
      padding: var(--space-md) var(--space-xl);
      width: 100%;
    }

    :global(:has(.menu-button[aria-expanded="true"])) .menu-close-button {
      display: block;
      position: absolute;
      top: var(--space-md);
      right: var(--space-md);
      background: none;
      border: none;
      color: var(--color-text);
      font-size: var(--font-size-3xl);
      cursor: pointer;
      padding: var(--space-xs) var(--space-sm);
      line-height: 1;
      transition: color var(--transition-fast);
    }

    :global(:has(.menu-button[aria-expanded="true"])) .menu-close-button:hover {
      color: var(--color-accent);
    }
  }

  /* Desktop */
  @media screen and (min-width: 640px) {
    .nav-links {
      display: block;
      position: static;
      width: auto;
      background: none;
    }

    .nav-links a {
      display: inline-block;
      padding: var(--space-md) var(--space-lg);
    }

    .menu-close-button {
      display: none !important;
    }
  }
</style>
