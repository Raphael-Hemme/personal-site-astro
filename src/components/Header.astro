---
import Navigation from './Navigation.astro';
import MenuButton from './MenuButton.astro';

const currentPath = Astro.url.pathname;
---

<header class="header" aria-label="Site header">
  <!-- Menu button (mobile only, left-aligned) -->
  <div class="menu-btn-wrapper">
    <MenuButton />
  </div>

  <!-- Desktop corner nav (hidden below 900px) -->
  <nav class="corner" aria-label="Main navigation">
    <Navigation currentPath={currentPath} variant="corner" />
  </nav>
</header>

<style>
  .header {
    padding: var(--pad);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.3s, border-color 0.3s;
  }

  /* ── Menu button — left-aligned (mobile only) ── */
  .menu-btn-wrapper {
    display: block;
  }

  /* ── Desktop corner nav — hidden below 900px ── */
  .corner {
    display: none;
  }

  @media (min-width: 900px) {
    .header {
      background-color: transparent;
      border-bottom: none;
      padding: 0;
    }

    /* Hide menu button on desktop */
    .menu-btn-wrapper {
      display: none;
    }

    /* Show desktop corner nav */
    .corner {
      display: block;
      padding: var(--pad);
    }
  }
</style>
