---
import Navigation from './Navigation.astro';
import MenuButton from './MenuButton.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
  <div class="header-inner">
    <MenuButton />
    <div id="main-menu" class="menu-panel" aria-hidden="true">
      <button class="menu-close-button" aria-label="Close menu">&times;</button>
      <nav class="primary-nav" aria-label="Primary">
        <Navigation />
      </nav>
      <div class="menu-utilities">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  header {
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-sm) var(--space-md);
  }

  .menu-panel {
    width: 100%;
  }

  .primary-nav {
    width: 100%;
  }

  .menu-utilities {
    display: flex;
    justify-content: center;
    padding: var(--space-sm) 0;
  }

  .menu-close-button {
    display: none;
  }

  @media screen and (max-width: 639px) {
    .menu-panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: var(--space-xl);
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 100;
      background-color: var(--color-bg-surface);
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity var(--transition-base-duration) var(--transition-ease),
        transform var(--transition-base-duration) var(--transition-ease),
        visibility 0s linear;
      transition-delay: 0s, 0s, var(--transition-base-duration);
    }

    .menu-panel.is-open {
      opacity: 1;
      transform: translateY(0) scale(1);
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s, 0s, 0s;
    }

    .menu-close-button {
      display: block;
      background: none;
      border: none;
      color: var(--color-link);
      font-size: var(--font-size-3xl);
      cursor: pointer;
      padding: var(--space-xs) var(--space-sm);
      line-height: 1;
      transition: color var(--transition-fast);
    }

    .menu-close-button:hover {
      color: var(--color-link-hover);
    }
  }

  @media screen and (min-width: 640px) {
    .menu-panel {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-sm);
      position: static;
      width: auto;
    }

    .primary-nav {
      width: auto;
    }

    .menu-utilities {
      padding: 0 0 0 var(--space-sm);
    }

    .menu-close-button {
      display: none !important;
    }
  }
</style>
