---
import Social from './Social.astro';

const platforms = [
  {
    id: 'github',
    name: 'GitHub',
    url: 'https://www.github.com/raphael-hemme/',
    icon: ''
  },
  {
    id: 'mastodon',
    name: 'Mastodon',
    url: 'https://mastodon.social/@raphael_hemme',
    icon: ''
  },
  {
    id: 'bluesky',
    name: 'Bluesky',
    url: 'https://bsky.app/profile/raphael-hemme.bsky.social',
    icon: ''
  },
  {
    id: 'linkedin',
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/raphael-hemme/',
    icon: ''
  }
]
---

<footer class="site-footer">
  {platforms.map(platform => <Social platform={platform} />)}
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    padding: var(--space-lg) 0 var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }
</style>
