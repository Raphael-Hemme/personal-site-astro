---
import Tag from './Tag.astro';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="tags">
  {tags.map((tag: string) => <Tag tag={tag}/>)}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: var(--space-md) 0;
    list-style-type: none;
    margin: 0;
    padding-inline-start: 0;
  }
</style>
